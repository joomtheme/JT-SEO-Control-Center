<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" version="6.0" method="upgrade">
    <name>System - JT SEO Control Center</name>
    <author>JoomTheme</author>
    <creationDate>2026-10-27</creationDate>
    <copyright>(C) 2026 JoomTheme. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>support@joomtheme.com</authorEmail>
    <authorUrl>https://joomtheme.com</authorUrl>
    <version>1.0.70</version>
    <description>PLG_SYSTEM_JTSEO_XML_DESCRIPTION</description>
    <scriptfile>script.php</scriptfile>
    <namespace path="src">JoomTheme\Plugin\System\Jtseo</namespace>
    <files>
        <folder plugin="jtseo">services</folder>
        <folder>src</folder>
        <filename>script.php</filename>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_jtseo.ini</language>
        <language tag="en-GB">en-GB/plg_system_jtseo.sys.ini</language>
        <language tag="tr-TR">tr-TR/plg_system_jtseo.ini</language>
        <language tag="tr-TR">tr-TR/plg_system_jtseo.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_SYSTEM_JTSEO_FIELDSET_BASIC_LABEL">
                <field
                    name="add_og_site_name"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_JTSEO_FIELD_ADD_OG_SITE_NAME_LABEL"
                    description="PLG_SYSTEM_JTSEO_FIELD_ADD_OG_SITE_NAME_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="add_generator_meta"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    label="PLG_SYSTEM_JTSEO_FIELD_ADD_GENERATOR_LABEL"
                    description="PLG_SYSTEM_JTSEO_FIELD_ADD_GENERATOR_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="remove_joomla_generator"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_JTSEO_FIELD_REMOVE_JOOMLA_GENERATOR_LABEL"
                    description="PLG_SYSTEM_JTSEO_FIELD_REMOVE_JOOMLA_GENERATOR_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
